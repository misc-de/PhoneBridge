import os
import sys

# Installed: <prefix>/bin/phonebridge next to <prefix>/lib/phonebridge.
# From the source tree: the repository itself.
here = os.path.dirname(os.path.realpath(__file__))
for p in (os.path.join(here, "..", "lib", "phonebridge"), os.path.join(here, "..")):
    if os.path.isdir(os.path.join(p, "phonebridge")):
        sys.path.insert(0, os.path.abspath(p))
        break

from phonebridge.deps import check_required_or_exit  # noqa: E402

check_required_or_exit()        # GTK, libadwaita, pycairo, ssh - said before any window

from phonebridge.app import main  # noqa: E402

sys.exit(main())
