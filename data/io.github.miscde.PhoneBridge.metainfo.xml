<component type="desktop-application">
  <id>io.github.miscde.PhoneBridge</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>PhoneBridge</name>
  <summary>Your Linux phone on your Linux desktop</summary>
  <summary xml:lang="de">Dein Linux-Phone auf deinem Linux-Desktop</summary>
  <developer id="io.github.miscde">
    <name>misc-de</name>
  </developer>
  <description>
    <p>
      Battery and messages in the panel, and a window for calls, SMS, contacts,
      appointments, files and the phone's settings - over SSH, with nothing to
      install on the phone.
    </p>
    <p xml:lang="de">
      Akku und Nachrichten im Panel, dazu ein Fenster für Anrufe, SMS, Kontakte,
      Termine, Dateien und die Einstellungen des Telefons - über SSH, ohne etwas
      auf dem Telefon zu installieren.
    </p>
    <p>
      Made for Phosh phones, and explicitly for the FuriLabs FLX1 / FLX1s running FuriOS.
    </p>
    <p xml:lang="de">
      Gemacht für Phosh-Telefone, ausdrücklich für das FuriLabs FLX1 / FLX1s mit FuriOS.
    </p>
  </description>
  <launchable type="desktop-id">io.github.miscde.PhoneBridge.desktop</launchable>
  <url type="homepage">https://github.com/misc-de/PhoneBridge</url>
  <url type="bugtracker">https://github.com/misc-de/PhoneBridge/issues</url>
